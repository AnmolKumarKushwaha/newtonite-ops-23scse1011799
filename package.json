{
  "name": "relay-newtonite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "node server/local.mjs",
    "start:local": "node server/local.mjs",
    "build": "vite build --config vite.local.config.mjs",
