    "test": "node --test tests/*.test.mjs",
    "seed:large": "node server/seed-large.mjs",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0",
    "drizzle-orm": "0.45.2"
